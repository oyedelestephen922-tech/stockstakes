# Public site URL (used for Open Graph links)
NEXT_PUBLIC_SITE_URL=https://stockstakes.fun

# Chain the site stakes on: 4663 = Robinhood Chain mainnet (default), 46630 = testnet.
# Round contract addresses are NOT set here — the deploy script writes lib/web3/deployment.ts.
NEXT_PUBLIC_CHAIN_ID=

# Optional: a private RPC for reads (e.g. Alchemy). Defaults to the chain's public RPC.
NEXT_PUBLIC_RPC_URL=

# Leave empty until the token launches — never put a placeholder address here
NEXT_PUBLIC_STAKES_TOKEN_ADDRESS=

# Optional: free key from finnhub.io for more reliable stock prices
FINNHUB_API_KEY=

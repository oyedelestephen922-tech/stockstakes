{
  "name": "stockstakes-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^24.19.2",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "hardhat": "^3.19.0",
    "typescript": "^5.9.3",
    "viem": "^2.57.6"
  },
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:sol": "hardhat test solidity",
    "typecheck": "hardhat build && tsc --noEmit",
    "deploy": "hardhat run --build-profile production scripts/deploy.ts --network robinhood",
    "deploy:testnet": "hardhat run --build-profile production scripts/deploy.ts --network robinhoodTestnet",
    "export:site": "node scripts/export-site.ts",
    "fork:node": "hardhat node --network robinhoodFork",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost"
  }
}

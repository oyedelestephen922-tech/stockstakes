# Copy to contracts/.env and fill in. NEVER commit .env or paste keys anywhere.

# Wallet that deploys and owns the contracts (needs a little ETH on Robinhood Chain for gas).
DEPLOYER_PRIVATE_KEY=

# Address of the keeper wallet that posts prices every hour (a separate, low-value wallet).
# Its private key goes into GitHub → Settings → Secrets → KEEPER_PRIVATE_KEY, not here.
KEEPER_ADDRESS=

# Optional. Who can void a bad price during its 1-hour challenge window. Defaults to the deployer.
GUARDIAN_ADDRESS=

# Optional. Who owns the contracts (pause, limits, fees). Defaults to the deployer.
OWNER_ADDRESS=

# Optional. A private RPC (e.g. Alchemy) is more reliable than the public, rate-limited one.
ROBINHOOD_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=

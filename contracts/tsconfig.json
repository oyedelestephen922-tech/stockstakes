{
  "compilerOptions": {
    "lib": [
      "es2023"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": [
        "../*"
      ]
    }
  },
  "include": [
    "hardhat.config.ts",
    "config/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "keeper/**/*.ts",
    "types/**/*.ts",
    "artifacts/**/*.d.ts"
  ]
}
